<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/default_padding"
    android:background="@color/light_gray">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/default_padding">

        <EditText
            android:id="@+id/etBackupPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/backup_file_path"
            android:inputType="none"
            android:focusable="false" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/default_padding">

        <Button
            android:id="@+id/btnPickBackupFile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/pick_file"
            android:layout_marginEnd="@dimen/small_padding" />

        <Button
            android:id="@+id/btnCreateBackup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/create_backup"
            android:layout_marginStart="@dimen/small_padding" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/default_padding">

        <Button
            android:id="@+id/btnShareBackup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/share_backup"
            android:layout_marginEnd="@dimen/small_padding" />

        <Button
            android:id="@+id/btnRestoreBackup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/restore_backup"
            android:layout_marginStart="@dimen/small_padding" />
    </LinearLayout>
</LinearLayout>
