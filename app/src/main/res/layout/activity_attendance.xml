<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/default_padding"
    android:background="@color/light_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/default_padding">

        <Button
            android:id="@+id/btnPreviousDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="← Prev"
            android:layout_marginEnd="@dimen/small_padding" />

        <TextView
            android:id="@+id/tvAttendanceDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Today"
            android:textSize="@dimen/text_size_large"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/primary" />

        <Button
            android:id="@+id/btnNextDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Next →"
            android:layout_marginStart="@dimen/small_padding" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/default_padding">

        <Button
            android:id="@+id/btnToday"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/today"
            android:layout_marginEnd="@dimen/small_padding" />

        <Button
            android:id="@+id/btnPickDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/date_picker"
            android:layout_marginStart="@dimen/small_padding" />
    </LinearLayout>

    <Button
        android:id="@+id/btnMarkAllPresent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/mark_all_present"
        android:layout_marginBottom="@dimen/default_padding" />

    <ListView
        android:id="@+id/lvAttendance"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="@dimen/default_padding" />

    <Button
        android:id="@+id/btnSaveAttendance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save_attendance"
        android:textSize="@dimen/text_size_medium" />
</LinearLayout>
