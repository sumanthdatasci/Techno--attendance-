<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_scheme"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AttendanceManager"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.AttendanceActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".activities.MembersActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".activities.ReportsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".activities.AbsenteesActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".activities.AddEditMemberActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".activities.MemberDetailsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".activities.SettingsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".activities.BackupRestoreActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".activities.MonthlyReportActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".activities.HolidayManagementActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

    </application>

</manifest>
